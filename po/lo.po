#: src/SettingsDialog.cpp:39
#, c-format
msgid "<b>Only the first %u hotkeys are enabled.</b>\n"
msgstr "<b> ເປີດໃຊ້ງານສະເພາະປຸ່ມລັດ%u ອັນທຳອິດເທົ່ານັ້ນ.</b>\n"

#: src/SettingsDialog.cpp:46
msgid "<b>Only the first hotkey is enabled.</b>\n"
msgstr "<b>ເປີດໃຊ້ງານສະເພາະປຸ່ມລັດທຳອິດເທົ່ານັ້ນ.</b>\n"

